# Copy to a private .env outside the static site. Never commit credentials.
HOST=127.0.0.1
PORT=8055
DB_CLIENT=sqlite3
DB_FILENAME=./data/gl-study.db
SECRET=GENERATE_A_RANDOM_SECRET_BEFORE_BOOTSTRAP
PUBLIC_URL=http://127.0.0.1:8055
CORS_ENABLED=false
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=30
RATE_LIMITER_DURATION=1
AUTH_LOGIN_ATTEMPTS=5
AUTH_PASSWORD_POLICY=/(?=.{12,})(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])/
SESSION_COOKIE_SECURE=false
ROBOTS_TXT="User-agent: *\nDisallow: /"
