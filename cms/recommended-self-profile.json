{
  "collection": "directus_users",
  "action": "update",
  "permissions": {
    "id": {
      "_eq": "$CURRENT_USER"
    }
  },
  "fields": [
    "first_name",
    "last_name",
    "email",
    "password",
    "location",
    "title",
    "description",
    "avatar",
    "language",
    "appearance",
    "theme_light",
    "theme_dark",
    "theme_light_overrides",
    "theme_dark_overrides",
    "tfa_secret"
  ]
}
